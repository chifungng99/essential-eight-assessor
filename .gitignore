# macOS
.DS_Store
**/.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Assessment data.
# Nothing containing a real organisation's assessment answers or evidence belongs
# in this repository. A completed self-assessment is a map of where an organisation
# is weakest, which makes it one of the more sensitive documents it owns. Example
# fixtures used by the tests live under examples/ and are deliberately fictional.
assessments/
*.assessment.json
reports/

# Official ASD source documents.
# Kept locally so the project is self-contained on disk, but never committed. The
# text is CC BY 4.0, however the Commonwealth Coat of Arms and the ASD logo inside
# these PDFs are explicitly excluded from that licence, so redistributing the files
# would redistribute those marks. README.md says where to download them.
sources/
